# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ─── Alertas de stock bajo por correo (Resend) ───────────────────────────────
# Solo se usan en el backend (funciones /api). No se incluyen en el bundle del frontend.
RESEND_API_KEY=re_xxxxxxxx
# Destinatario de los avisos de stock bajo.
# Con el dominio de pruebas de Resend debe ser el correo dueño de la cuenta de Resend.
LOW_STOCK_ALERT_EMAIL=avisos@ejemplo.com
# Remitente (opcional). Por defecto: "onboarding@resend.dev".
# Con el dominio de pruebas de Resend solo se puede enviar al correo dueño de la
# cuenta; para otros destinatarios verifica un dominio propio en Resend.
RESEND_FROM=Multiservicios J. Nieto <onboarding@resend.dev>

# ─── Alta de productos por voz (Gemini) ──────────────────────────────────────
# Solo backend (/api/voice-to-product). Consíguela en aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional. Por defecto: gemini-3.6-flash
GEMINI_MODEL=gemini-3.6-flash
